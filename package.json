{
  "name": "@ncpa0cpl/nodepack",
  "version": "2.3.8",
  "main": "./dist/legacy/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "scripts": {
    "fix:lint": "oxlint --fix",
    "fmt": "dprint fmt",
    "test:lint": "oxlint",
    "test:fmt": "dprint fmt --fail-on-change",
    "test:tsc": "tsc --noEmit",
    "build": "node ./scripts/build.cjs",
    "upgrade:deps": "node ./scripts/upgrade.mjs",
    "prepare": "husky install",
    "release": "git switch master && git push && git switch release && git rebase master && git push && git switch master"
  },
  "keywords": [
    "esbuild",
    "packaging",
    "cjs",
    "commonjs",
    "esm",
    "esmodules",
    "typescript"
  ],
  "repository": {
    "url": "https://github.com/ncpa0cpl/nodepack"
  },
  "description": "Simple packaging script for node libraries based on ESBuild",
  "license": "MIT",
  "author": {
    "name": "Szymon Bretner (ncpa0cpl)",
    "email": "szymonb21@gmail.com"
  },
  "dependencies": {
    "@ncpa0cpl/node-worker-bridge": "^0.0.4",
    "@ts-morph/bootstrap": "^0.29.0",
    "chokidar": "^3.5.3",
    "dilswer": "3.2.1",
    "lodash.mergewith": "^4.6.2",
    "node-os-walk": ">=1.0.2",
    "pretty-error": "^4.0.0",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "esbuild": ">0.28.1"
  },
  "optionalDependencies": {
    "json-to-ts": "^2.1.0"
  },
  "devDependencies": {
    "@ncpa0cpl/nodepack": "2.3.6",
    "@types/lodash.mergewith": "^4.6.9",
    "@types/node": "^20.2.5",
    "dprint": "^0.55.2",
    "esbuild": "^0.28.1",
    "esbuild-plugin-alias": "^0.2.1",
    "git-hook-tasks": "git+https://github.com/ncpa0cpl/git-hook-tasks#2.0.1",
    "husky": "^8.0.3",
    "json-to-ts": "^2.1.0",
    "oxlint": "^1.76.0",
    "pr-changelog-gen": "^1.1.3",
    "ts-node": "^10.9.2"
  },
  "packageManager": "yarn@1.22.19"
}
